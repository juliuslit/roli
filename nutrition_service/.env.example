# Copy the variable names into roli/.env (one level up) and fill in real values there.
# roli/.env is git-ignored; this file is not, so it must only ever hold placeholders.

# Required. Free key from https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=your_usda_key_here

# Optional. How long a USDA answer is kept in memory, in seconds (default one day).
ROLI_CACHE_TTL_SECONDS=86400

# Optional. How many answers are kept in memory before the oldest is dropped.
ROLI_CACHE_MAX_ENTRIES=1000

# Required by the MCP server only (Phase 1B): bearer token for /mcp, at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
ROLI_MCP_TOKEN=your_random_token_of_at_least_32_characters

# MCP server only: Host header values the server answers on (comma-separated; 'name:*' = any port).
# Default allows local use only. Add a tunnel or deployment hostname here. No other wildcards.
ROLI_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# MCP server only: browser origins accepted when an Origin header is present (server-to-server clients send none).
ROLI_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*

# Optional, MCP server only: where uvicorn listens (defaults shown).
HOST=127.0.0.1
PORT=8000
